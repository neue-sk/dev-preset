includes:
    - vendor/larastan/larastan/extension.neon
    # Uncomment the next line once a baseline has been generated:
    # - phpstan-baseline.neon

parameters:
    level: 9

    paths:
        - app
        - config
        - database
        - routes

    scanFiles:
        - _ide_helper_models.php
        - _ide_helper.php

    # Adjust to your modular layout. For app/Modules/{Module}, `app` above
    # already covers it. For packages/, add:
    #   - packages/*/src

    excludePaths:
        analyse:
            - app/Console/Kernel.php (?)
            - bootstrap/cache
            - storage
        analyseAndScan:
            - _ide_helper.php
            - _ide_helper_models.php
            - .phpstorm.meta.php

    checkModelProperties: true
    checkOctaneCompatibility: true
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false

    tmpDir: storage/phpstan
