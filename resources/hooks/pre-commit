#!/usr/bin/env bash
#
# Pre-commit hook — boilerplate quality gate.
# Mirrors CI exactly so "works locally" means "passes CI".
#
# Installed by: composer run hooks:install   (see scripts/install-hooks.sh)
# Bypass (discouraged, audited in CI): git commit --no-verify
#
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

echo -e "${YELLOW}▶ Running pre-commit quality gate...${NC}"

# Only run against staged PHP files for speed; fall back to full suite
# for analysis tools that need project-wide context.
STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.php$' || true)

if [ -z "$STAGED_PHP" ]; then
    echo -e "${GREEN}✓ No PHP changes staged — skipping PHP gate.${NC}"
    exit 0
fi

fail() { echo -e "${RED}✗ $1 failed. Commit aborted.${NC}"; exit 1; }

# 1. Pint — style check on staged files only (no auto-fix in hook).
echo "  → Pint (code style)"
vendor/bin/pint --test -- $STAGED_PHP || fail "Pint"

# 2. Rector — dry run detects un-applied refactors.
echo "  → Rector (refactor)"
vendor/bin/rector process --no-progress-bar || fail "Rector"

# 3. Larastan — project-wide static analysis.
echo "  → Larastan (static analysis)"
vendor/bin/phpstan analyse --no-progress --memory-limit=2G || fail "Larastan"

# 4. Pest — full suite (use --filter in large repos if needed).
echo "  → Pest (tests)"
vendor/bin/pest --compact || fail "Pest"

echo -e "${GREEN}✓ All checks passed.${NC}"
exit 0
